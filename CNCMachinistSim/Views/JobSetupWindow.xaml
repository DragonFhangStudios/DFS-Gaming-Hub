<Window x:Class="CNCMachinistSim.Views.JobSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Job Setup" 
        Height="550"
        MinHeight="550"
        Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#ECF0F1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Job Info -->
            <RowDefinition Height="Auto"/> <!-- "Required Tools:" label -->
            <RowDefinition Height="Auto"/> <!-- Changed from * to Auto -->
            <RowDefinition Height="Auto"/> <!-- Strategy Selection -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Job Info -->
        <Border Grid.Row="0" Background="White" Padding="15" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="JobTitle" Text="Aluminum Pin" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="JobPay" Text="Pay: $25.00" FontSize="14" Foreground="#27AE60" Margin="0,5,0,0"/>
                <TextBlock x:Name="JobMaterial" Text="Material: $5.00" FontSize="12" Foreground="#E74C3C"/>
            </StackPanel>
        </Border>

        <!-- Required Tools -->
        <TextBlock Grid.Row="1" Text="Required Tools:" FontWeight="Bold" FontSize="14" Margin="0,10,0,5"/>

        <ListView Grid.Row="2" 
                  x:Name="RequiredToolsList"
                  Background="White"
                  BorderThickness="1"
                  BorderBrush="#BDC3C7"
                  Margin="0,0,0,15"
                  MaxHeight="200"
                  MinHeight="80"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- Condition percentage -->
                            <TextBlock Text="{Binding Condition, StringFormat='{}{0}%'}" 
                           FontSize="12"
                           FontWeight="Bold"
                           Margin="0,0,5,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <!-- Broken = RED with ✗ -->
                                            <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                            </DataTrigger>
                                            <!-- Worn = ORANGE -->
                                            <DataTrigger Binding="{Binding NeedsReplacement}" Value="True">
                                                <Setter Property="Foreground" Value="#E67E22"/>
                                            </DataTrigger>
                                            <!-- Good = GREEN -->
                                            <DataTrigger Binding="{Binding Condition}" Value="80">
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Warning icon for broken tools -->
                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="#E74C3C">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Text" Value="✗ BROKEN"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Strategy Selection -->
        <Border Grid.Row="3" Background="White" Padding="15" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Select Strategy:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <RadioButton x:Name="ConservativeRadio" 
                             GroupName="Strategy" 
                             IsChecked="True"
                             Margin="0,5">
                    <StackPanel>
                        <TextBlock Text="Conservative" FontWeight="Bold"/>
                        <TextBlock Text="Slower (75% time) • 95% success • 100% pay • 5% tool wear" 
                                   FontSize="11" 
                                   Foreground="#7F8C8D"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NormalRadio" 
                             GroupName="Strategy"
                             Margin="0,5">
                    <StackPanel>
                        <TextBlock Text="Normal" FontWeight="Bold"/>
                        <TextBlock Text="Standard (100% time) • 85% success • 110% pay • 10% tool wear" 
                                   FontSize="11" 
                                   Foreground="#7F8C8D"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="AggressiveRadio" 
                             GroupName="Strategy"
                             Margin="0,5">
                    <StackPanel>
                        <TextBlock Text="Aggressive" FontWeight="Bold"/>
                        <TextBlock Text="Fast (50% time) • 60% success • 125% pay • 20% tool wear" 
                                   FontSize="11" 
                                   Foreground="#7F8C8D"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Content="Cancel" 
                    Click="Cancel_Click"
                    Padding="10"
                    Margin="0,0,5,0"
                    Background="#95A5A6"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"/>

            <Button Grid.Column="1" 
                    Content="Start Job" 
                    Click="StartJob_Click"
                    Padding="10"
                    Margin="5,0,0,0"
                    Background="#27AE60"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>