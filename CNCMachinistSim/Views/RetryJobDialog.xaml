<Window x:Class="CNCMachinistSim.Views.RetryJobDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Job Failed" Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#ECF0F1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Failure Message -->
        <Border Grid.Row="0" 
                Background="#E74C3C" 
                Padding="15" 
                CornerRadius="5"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="⚠ PART REJECTED" 
                           FontSize="20" 
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="JobTitle"
                           Text="Aluminum Pin - Out of Tolerance"
                           FontSize="14"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Retry Info -->
        <Border Grid.Row="1"
                Background="White"
                Padding="15"
                CornerRadius="5"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="You can retry this job, but:" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="• " FontSize="13" Foreground="#E74C3C" FontWeight="Bold"/>
                    <TextBlock Text="Conservative strategy ONLY (slow and safe)" FontSize="13"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="• " FontSize="13" Foreground="#E74C3C" FontWeight="Bold"/>
                    <TextBlock x:Name="MaterialCostText" Text="DOUBLE material cost: $10.00" FontSize="13"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="• " FontSize="13" Foreground="#E74C3C" FontWeight="Bold"/>
                    <TextBlock Text="DOUBLE tool wear (running job again)" FontSize="13"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Retry attempt: " FontSize="13" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="RetryCountText" Text="#1" FontSize="13" FontWeight="Bold" Foreground="#E67E22"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Financial Summary -->
        <Border Grid.Row="2"
                Background="#FCF3CF"
                Padding="15"
                CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Financial Impact:" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Scrap recovery:" FontSize="13" Margin="0,3"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ScrapValueText" Text="+$2.50" FontSize="13" Foreground="#27AE60" FontWeight="Bold" Margin="0,3"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="New materials:" FontSize="13" Margin="0,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="NewMaterialCostText" Text="-$10.00" FontSize="13" Foreground="#E74C3C" FontWeight="Bold" Margin="0,3"/>

                    <Rectangle Grid.Row="2" Grid.ColumnSpan="2" Height="1" Fill="#BDC3C7" Margin="0,10"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Net cost to retry:" FontSize="14" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="NetCostText" Text="-$7.50" FontSize="14" Foreground="#E74C3C" FontWeight="Bold" Margin="0,5"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Take the Loss"
                    Click="TakeLoss_Click"
                    Padding="15,12"
                    Margin="0,0,5,0"
                    Background="#95A5A6"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="Bold"/>

            <Button Grid.Column="1"
                    Content="Retry Job"
                    Click="RetryJob_Click"
                    Padding="15,12"
                    Margin="5,0,0,0"
                    Background="#E67E22"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>