<Window x:Class="DFS.WPFLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DFS Gaming Hub" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid>
        <ScrollViewer>
            <ItemsControl x:Name="GameList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Title}" 
                                Tag="{Binding DirectoryName}"
                                Click="LaunchGame_Click" 
                                Margin="10" Padding="15"
                                FontSize="16" Background="#333" Foreground="White"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>